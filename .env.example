# Copia este archivo como .env.local y rellena los valores.
# No escribas claves reales en el repositorio.

# Proyecto Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# URL canónica de la app. En producción: https://hospyia.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Solo para scripts locales (seed y verificación de RLS). NUNCA en el cliente.
# Con las nuevas API keys de Supabase es la "secret key" (sb_secret_...).
# Con proyectos antiguos, la service_role key.
SUPABASE_SECRET_KEY=

# Usuario de pruebas E2E. Se crea con `npm run seed` si hay SUPABASE_SECRET_KEY.
E2E_EMAIL=hospyia.e2e@example.com
E2E_PASSWORD=ChangeMe-OnlyForTests-123!
